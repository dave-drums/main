{
  "name": "dave-drums-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dave Drums website, metronome and Groove Lab",
  "workspaces": [
    "apps/metronome"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node build/dev.mjs",
    "build": "node build/site.mjs",
    "build:tools": "node build/tools.mjs",
    "sync:tools": "node build/sync-tool-theme.mjs",
    "test": "node build/test.mjs",
    "preview": "node build/preview.mjs",
    "test:browser": "playwright test --config tests/playwright.config.mjs",
    "check:tools": "node build/sync-tool-theme.mjs --check"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "jsdom": "30.1.3"
  }
}
